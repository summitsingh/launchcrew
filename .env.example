# LaunchCrew local backend environment example, tracked placeholder only.
# This file holds no real credential. Copy it once to private
# .local/.env.local (mode 600, stays ignored) and set the existing
# dedicated product key there. Never commit the real key.
# META_API_KEY is the existing portal product key, read from the backend
# process environment at runtime. No separate key is created. An empty
# value means keyless deterministic fallback with no model network call.
META_API_KEY=
# Paid SAM photo check stays OFF by default. False means no automatic
# live call. SAM stays off and the global one-shot budget stays 0 until
# a separately authorized one-shot setup runs. Ordinary runs with a
# configured key can invoke Spark text synthesis, so run no paid
# workflow until an approved controlled execution.
LAUNCHCREW_PHOTO_SAM_ENABLED=false
# Bounded live proof placeholders only, no values here. Root supplies a
# private env file with the real private DB, approved digest list, and
# proof photo path for an explicit live run. No live HTTP without --live.
# LAUNCHCREW_PHOTO_APPROVED_DIGESTS=
# LAUNCHCREW_PROOF_PHOTO_PATH=
# LAUNCHCREW_PROOF_LATCH_FILE=
